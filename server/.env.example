# Copy this file to `.env` (same folder) and fill in your values.

# MongoDB connection (required). Local install or a free MongoDB Atlas cluster:
#   mongodb://127.0.0.1:27017/lumora
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lumora
MONGODB_URI=mongodb://127.0.0.1:27017/lumora

# Optional: database name (default "lumora")
# MONGODB_DB=lumora

# Optional: if Atlas fails with "querySrv ECONNREFUSED", your network's DNS blocks the lookup.
# Use public DNS instead:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Claude API key for the AI helpline (optional). Without it, the helpline gives simple built-in replies.
ANTHROPIC_API_KEY=

# Optional: port for the API (default 4000)
# PORT=4000
